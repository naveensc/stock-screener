# ─────────────────────────────────────────────────────────────────────────────
#  Stock Screener — Environment Variables
#  Copy to .env for local development. Never commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# Email — Gmail SMTP (use an App Password, not your regular password)
EMAIL_SMTP_USER=your_gmail@gmail.com
EMAIL_SMTP_PASSWORD=your_app_password_here

# Recipients (comma-separated)
RECIPIENTS=you@example.com
